# NOTE: state/ is intentionally NOT ignored — non-PII run state must be
# committed so it survives between ephemeral GitHub Actions jobs.

# Dry-run sheet mirror: local-only mock data (fake emails/phones) that must
# never enter the public repo; regenerated automatically in dry-run mode.
state/sheet_mirror.json

# never commit token temps
state/.gh_token*
*.tmp
